{
  "latex-workshop.latex.outDir": ".",
  "latex-workshop.view.pdf.viewer": "tab",
  

  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-biber",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-bibtex",
        "-outdir=.",
        "%DOC%"
      ]
    },
    {
      "name": "latexmk-pdf",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-outdir=.",
        "%DOC%"
      ]
    }
  ],

  "latex-workshop.latex.recipes": [
    { "name": "latexmk (biber)", "tools": ["latexmk-biber"] },
    { "name": "latexmk (pdf)", "tools": ["latexmk-pdf"] }
  ]


}
